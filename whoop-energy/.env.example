# WHOOP Developer application credentials.
# Create an app at https://developer-dashboard.whoop.com/ and copy the values here.
# Copy this file to `.env` (same directory) — `.env` is git-ignored, never commit it.

# Required for `whoop-energy auth` / `sync`.
WHOOP_CLIENT_ID=your-client-id
WHOOP_CLIENT_SECRET=your-client-secret

# Must match EXACTLY one of the redirect URIs registered in the WHOOP dashboard.
# The port is used for the local OAuth callback server. Default: http://localhost:8787/callback
WHOOP_REDIRECT_URI=http://localhost:8787/callback

# Where tokens.json / cache.json / settings.json live. Default: ~/.whoop-energy
# WHOOP_ENERGY_HOME=/absolute/path/to/data-dir

# Optional overrides
# WHOOP_API_BASE=https://api.prod.whoop.com/developer/v2
# WHOOP_OAUTH_BASE=https://api.prod.whoop.com/oauth/oauth2
