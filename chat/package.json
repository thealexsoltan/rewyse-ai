{
  "name": "rewyse-chat",
  "private": true,
  "version": "0.1.0",
  "description": "iMessage-style chat for the Rewyse bot team. Every bot is a live Claude Code session.",
  "type": "module",
  "scripts": {
    "start": "npm run build && tsx server/index.ts",
    "dev": "concurrently -k -n server,ui \"tsx watch server/index.ts\" \"vite\"",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.0",
    "express": "^5.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ws": "^8.18.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.5.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
